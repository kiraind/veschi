// Veschi data model. See docs/spec.md ("Модель данных") and docs/decisions.md.
//
// Ownership: every catalog record is either personal (ownerId) or shared
// (householdId) — exactly one of the two is set. The MVP only creates personal
// records; households exist in the schema so the model does not need to change
// later. The "exactly one" rule is enforced by CHECK constraints in the
// migration SQL and by the service layer.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // `include` / nested `select` load relations in the same SQL query (a JOIN)
  // instead of one extra round-trip per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, sessions, households
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  login           String   @unique
  passwordHash    String
  name            String
  // Workbench used last; picked when the current position is outside every geofence.
  lastWorkbenchId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lastWorkbench Item?        @relation("UserLastWorkbench", fields: [lastWorkbenchId], references: [id], onDelete: SetNull)
  sessions      Session[]
  memberships   Membership[]

  ownedTypes        ItemType[]       @relation("ItemTypeOwner")
  ownedItems        Item[]           @relation("ItemOwner")
  takenItems        Item[]           @relation("ItemTakenBy")
  ownedStickers     Sticker[]        @relation("StickerOwner")
  ownedBatches      StickerBatch[]   @relation("StickerBatchOwner")
  ownedDictionaries EnumDictionary[] @relation("EnumDictionaryOwner")
  ownedParamDefs    ParamDef[]       @relation("ParamDefOwner")
  ownedCategories   Category[]       @relation("CategoryOwner")
  ownedCollections  Collection[]     @relation("CollectionOwner")
  ownedEvents       HistoryEvent[]   @relation("HistoryEventOwner")
  actedEvents       HistoryEvent[]   @relation("HistoryEventActor")
}

model Session {
  // SHA-256 of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  types        ItemType[]
  items        Item[]
  stickers     Sticker[]
  batches      StickerBatch[]
  dictionaries EnumDictionary[]
  paramDefs    ParamDef[]
  categories   Category[]
  collections  Collection[]
  events       HistoryEvent[]
}

enum HouseholdRole {
  ADMIN
  MEMBER
}

model Membership {
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([userId, householdId])
}

model Invitation {
  id          String   @id @default(cuid())
  householdId String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ItemType {
  id          String   @id @default(cuid())
  ownerId     String?
  householdId String?
  name        String
  // Free-text description; search matches it too.
  description String?
  // Items of a container type can hold other items (and always have quantity 1).
  isContainer Boolean  @default(false)
  // Object key of the single photo in S3/MinIO; shared by every item of the type.
  photoKey    String?
  // Barcode from the packaging (EAN-13, EAN-8, UPC, GTIN-14), never issued by
  // the app; one per type and one type per barcode of an owner. Stored form of
  // src/lib/domain/barcode.ts (digits, UPC-A as EAN-13).
  barcode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User?             @relation("ItemTypeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household         Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items             Item[]
  params            Param[]           @relation("TypeParams")
  paramRefs         ParamRef[]        @relation("ParamRefType")
  categories        TypeCategory[]
  collectionEntries CollectionEntry[]

  @@unique([ownerId, barcode])
  @@unique([householdId, barcode])
  @@index([ownerId])
  @@index([householdId])
  // Access check of every photo request (/files).
  @@index([photoKey])
}

enum ItemStatus {
  ACTIVE
  ARCHIVED
}

model Item {
  id          String     @id @default(cuid())
  ownerId     String?
  householdId String?
  // Required for every item except workbenches (enforced by the service layer).
  typeId      String?
  // Own name of this instance; when empty the type name is shown.
  name        String?
  // At least 1 (CHECK Item_quantity_positive); always 1 for containers (items
  // of a container type), workbenches and items with a sticker (services).
  quantity    Int        @default(1)
  // Where the item lies; null = top level.
  parentId    String?
  // Container the item was taken from (set while the item is on a workbench).
  homeId      String?
  // Record this part was split from when taking part of the quantity.
  splitFromId String?
  // Who took the item to a workbench.
  takenById   String?
  takenAt     DateTime?
  status      ItemStatus @default(ACTIVE)
  archivedAt  DateTime?

  isWorkbench      Boolean   @default(false)
  // Optional geofence of a workbench.
  geoLat           Float?
  geoLng           Float?
  geoRadiusM       Float?
  // Icon of a workbench: a key from WORKBENCH_ICONS (src/lib/domain/workbench-icons.ts).
  icon             String?
  // A sticker is ordered for this record («Заказать наклейку»): it is printed
  // and bound to the record with the next batch (issueBatch).
  stickerOrderedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?      @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type      ItemType?  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  parent    Item?      @relation("ItemParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Item[]     @relation("ItemParent")
  home      Item?      @relation("ItemHome", fields: [homeId], references: [id], onDelete: SetNull)
  homed     Item[]     @relation("ItemHome")
  splitFrom Item?      @relation("ItemSplit", fields: [splitFromId], references: [id], onDelete: SetNull)
  splits    Item[]     @relation("ItemSplit")
  takenBy   User?      @relation("ItemTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  sticker            Sticker?
  params             Param[]           @relation("ItemParams")
  paramRefs          ParamRef[]        @relation("ParamRefItem")
  lastWorkbenchUsers User[]            @relation("UserLastWorkbench")
  collectionEntries  CollectionEntry[]

  @@index([ownerId, status])
  @@index([householdId, status])
  @@index([parentId])
  @@index([typeId])
  @@index([homeId])
  @@index([splitFromId])
}

// ---------------------------------------------------------------------------
// Stickers
// ---------------------------------------------------------------------------

enum StickerStatus {
  FREE
  BOUND
  WRITTEN_OFF
}

// One generated PDF sheet set; kept so a lost PDF can be downloaded again.
model StickerBatch {
  id          String   @id @default(cuid())
  ownerId     String?
  householdId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?      @relation("StickerBatchOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stickers  Sticker[]

  @@index([ownerId, createdAt])
}

model Sticker {
  id          String        @id @default(cuid())
  // 6 characters without the dash, upper case, e.g. "K7M4QX". Unique server-wide.
  code        String        @unique @db.Char(6)
  caption     String?
  status      StickerStatus @default(FREE)
  // Bound item; kept for written-off stickers so restoring the item rebinds it.
  itemId      String?       @unique
  batchId     String?
  // Position of the sticker inside its batch (print order).
  position    Int           @default(0)
  // Printed for an ordered item and bound to it on issue; marking the batch
  // unprinted gives the item its order back.
  fromOrder   Boolean       @default(false)
  ownerId     String?
  householdId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  item      Item?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  batch     StickerBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  owner     User?         @relation("StickerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------

model EnumDictionary {
  id          String   @id @default(cuid())
  ownerId     String?
  householdId String?
  name        String
  multiple    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?        @relation("EnumDictionaryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household?   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  options   EnumOption[]
  params    Param[]
  // The ENUM parameter whose options these are; a list belongs to exactly one.
  paramDef  ParamDef?

  @@index([ownerId])
}

model EnumOption {
  id           String   @id @default(cuid())
  dictionaryId String
  label        String
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dictionary EnumDictionary   @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  values     ParamEnumValue[]

  @@index([dictionaryId, position])
}

enum ParamValueType {
  STRING
  NUMBER
  RANGE
  ENUM
  URL
  FILE
  DATE
  BOOLEAN
  // Links: the value is one or more items (ITEM) or types (TYPE). Every link
  // parameter has an inverse (ParamDef.inverseId); see ParamRef.
  ITEM
  TYPE
}

// A parameter («Параметры» page): its name, value type, unit (numbers) and
// option list (ENUM), shared by every type and item that has a value for it.
// Names are unique per owner (case-insensitive, checked by the service layer).
//
// A link (ITEM, TYPE) always comes with its inverse: «Содержит деталь» ↔
// «Является деталью». Each points at the other (inverseId); a symmetric link
// («Совместим с») is its own inverse. A link value on A pointing at B is
// mirrored by an inverse value on B pointing at A (services/params.ts). So a
// link lives only on holders of one kind: the inverse's value type (ITEM →
// on items, TYPE → on types). See docs/decisions.md, «Связи».
model ParamDef {
  id           String         @id @default(cuid())
  ownerId      String?
  householdId  String?
  name         String
  valueType    ParamValueType
  // NUMBER, RANGE: unit of every value («мм», «В»).
  unit         String?
  // ENUM: the parameter's own option list.
  dictionaryId String?        @unique
  // ITEM, TYPE: the inverse link (itself when symmetric).
  inverseId    String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner      User?           @relation("ParamDefOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household  Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dictionary EnumDictionary? @relation(fields: [dictionaryId], references: [id], onDelete: Restrict)
  inverse    ParamDef?       @relation("ParamDefInverse", fields: [inverseId], references: [id], onDelete: NoAction)
  inverseOf  ParamDef?       @relation("ParamDefInverse")
  values     Param[]
  categories CategoryParam[]

  @@index([ownerId])
  @@index([householdId])
}

// The value of a parameter for a type (shared by all its items) or for one
// item. Exactly one of typeId / itemId is set. valueType and dictionaryId
// repeat the definition's; which value columns are used depends on valueType
// (see src/lib/domain/params.ts).
model Param {
  id        String         @id @default(cuid())
  defId     String
  typeId    String?
  itemId    String?
  valueType ParamValueType
  position  Int            @default(0)

  textValue    String? // STRING, URL
  numberValue  Float? // NUMBER; RANGE minimum
  numberMax    Float? // RANGE maximum
  dateValue    DateTime? @db.Date // DATE
  boolValue    Boolean? // BOOLEAN
  fileKey      String? // FILE: object key in S3/MinIO
  fileName     String? // FILE: original file name
  fileMime     String? // FILE: content type
  fileSize     Int? // FILE: bytes
  dictionaryId String? // ENUM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  def        ParamDef         @relation(fields: [defId], references: [id], onDelete: Restrict)
  type       ItemType?        @relation("TypeParams", fields: [typeId], references: [id], onDelete: Cascade)
  item       Item?            @relation("ItemParams", fields: [itemId], references: [id], onDelete: Cascade)
  dictionary EnumDictionary?  @relation(fields: [dictionaryId], references: [id], onDelete: Restrict)
  enumValues ParamEnumValue[]
  refs       ParamRef[]

  @@unique([typeId, defId])
  @@unique([itemId, defId])
  @@index([defId])
  @@index([fileKey])
  // Deleting a dropdown list checks that no value uses it (onDelete: Restrict).
  @@index([dictionaryId])
}

// One target of a link value (ITEM, TYPE): an item or a type, exactly one
// (CHECK ParamRef_target_xor). A link value has one or more.
model ParamRef {
  id      String  @id @default(cuid())
  paramId String
  itemId  String?
  typeId  String?

  param Param     @relation(fields: [paramId], references: [id], onDelete: Cascade)
  item  Item?     @relation("ParamRefItem", fields: [itemId], references: [id], onDelete: Cascade)
  type  ItemType? @relation("ParamRefType", fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([paramId, itemId])
  @@unique([paramId, typeId])
  @@index([itemId])
  @@index([typeId])
}

model ParamEnumValue {
  paramId  String
  optionId String

  param  Param      @relation(fields: [paramId], references: [id], onDelete: Cascade)
  option EnumOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([paramId, optionId])
  @@index([optionId])
}

// ---------------------------------------------------------------------------
// Categories («Категории»)
// ---------------------------------------------------------------------------

// A category («Еда», «Электроника») lists parameters a type in it must have
// filled: some once for the whole type (КБЖУ), some on every item (срок
// годности). A type may be in several categories; categories do not inherit
// from each other. See docs/decisions.md, «Категории».
model Category {
  id          String   @id @default(cuid())
  ownerId     String?
  householdId String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?           @relation("CategoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  params    CategoryParam[]
  types     TypeCategory[]

  @@index([ownerId])
  @@index([householdId])
}

// Where a required parameter must have its value.
enum ParamLevel {
  // Once on the type, shared by all its items.
  TYPE
  // On each item itself (an own value; the type's does not count).
  ITEM
}

// A parameter a category requires, and where.
model CategoryParam {
  categoryId String
  defId      String
  level      ParamLevel
  position   Int        @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  def      ParamDef @relation(fields: [defId], references: [id], onDelete: Restrict)

  @@id([categoryId, defId])
  @@index([defId])
}

model TypeCategory {
  typeId     String
  categoryId String
  createdAt  DateTime @default(now())

  type     ItemType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([typeId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Collections («Коллекции»)
// ---------------------------------------------------------------------------

// A named list of things and how many of each: the parts of a project
// («Умные весы»), a packing list. See docs/decisions.md, «Коллекции».
model Collection {
  id          String   @id @default(cuid())
  ownerId     String?
  householdId String?
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User?             @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   CollectionEntry[]

  @@index([ownerId])
  @@index([householdId])
}

// One line of a collection: any things of a type («ESP32 — 3 штуки») or one
// particular item («эти кухонные весы»). Exactly one of typeId / itemId is set
// (CHECK CollectionEntry_one_target); quantity is at least 1 (CHECK
// CollectionEntry_quantity_positive). Each type or item is in a collection once.
model CollectionEntry {
  id           String   @id @default(cuid())
  collectionId String
  typeId       String?
  itemId       String?
  quantity     Int      @default(1)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  type       ItemType?  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  item       Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, typeId])
  @@unique([collectionId, itemId])
  @@index([typeId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// History («История»)
// ---------------------------------------------------------------------------

// One change or movement, written by the service that made it in the same
// transaction. Entities are referenced by id without foreign keys and with
// their names at the moment of the event, so the history outlives deleted
// records. `kind` and `data` are described in src/lib/domain/history.ts.
model HistoryEvent {
  id          String   @id @default(cuid())
  // Scope of the subject: personal (ownerId) or shared (householdId).
  ownerId     String?
  householdId String?
  // Who did it; null for events carried over from before the history existed
  // without a known author, or when the user is gone.
  actorId     String?
  // E.g. "item.moved"; see HISTORY_KINDS.
  kind        String
  // "item" | "workbench" | "type" | "paramDef" | "batch"
  subjectKind String
  subjectId   String
  subjectName String
  // Every other entity involved (containers, parts, contents), for the entity filter.
  refIds      String[]
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  owner     User?      @relation("HistoryEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User?      @relation("HistoryEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([householdId, createdAt])
  // The «Кто» filter of «История».
  @@index([ownerId, actorId])
  @@index([subjectId])
  @@index([refIds], type: Gin)
}
