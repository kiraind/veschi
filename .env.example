# Environment variables of Veschi. Copy to .env for `npm run dev`; the values
# below match the dependencies from docker-compose.yml (`docker compose up -d postgres minio`).
# In the Docker image they are passed as container environment variables.

# HTTP port of the server (Docker image; `npm run dev` uses Vite's port 5173).
PORT=3000

# Public URL of the app. Required in production: SvelteKit checks the Origin
# header of form submissions against it.
ORIGIN=http://localhost:5173

# Short base URL printed into sticker QR codes: <QR_BASE_URL>/<CODE>.
# Defaults to ORIGIN; may be a separate short domain that redirects to the app.
# QR_BASE_URL=https://v.example.com

# PostgreSQL connection string.
DATABASE_URL=postgresql://veschi:veschi@localhost:5432/veschi

# MinIO / S3 storage. Without S3_ENDPOINT files are kept in memory and lost on
# restart (development only). The bucket is created on startup if missing.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=veschi
S3_SECRET_KEY=veschi-secret
S3_BUCKET=veschi
S3_REGION=us-east-1

# First user, created on startup if a user with this login does not exist.
# A restart does not touch an existing user's password.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin-password
# Display name (defaults to the login).
# ADMIN_NAME=Админ
# Set to 1 to reset that user's password to ADMIN_PASSWORD on startup (and end
# their sessions); remove it after signing in.
# ADMIN_RESET_PASSWORD=1

# Maximum request body size (adapter-node). Must exceed the 50 MB file limit;
# the Docker image sets 52M.
BODY_SIZE_LIMIT=52M

# Behind a reverse proxy: the header with the client address (adapter-node).
# Failed sign-ins are counted per login and per address.
# ADDRESS_HEADER=X-Forwarded-For

# Photo processing (README, «Обработка фото»): cutout removes the background of
# type photos on a ComfyUI server with the ComfyUI-RMBG nodes; off by default.
# PHOTO_PROCESSING=cutout
# PHOTO_PROCESSOR_URL=https://cloud.comfy.org
# Comfy Cloud only; a self-hosted ComfyUI needs no key.
# PHOTO_PROCESSOR_API_KEY=
